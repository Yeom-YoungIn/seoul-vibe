# 목적 - prod 환경 Terraform state backend 설정 예시를 제공하기 위해 추가됨
# 설명 - 운영 state는 dev와 다른 key를 사용해 분리하고, 실제 S3 bucket과 DynamoDB lock table 값으로 교체한다.
bucket         = "CHANGE_ME-seoul-vibe-terraform-state"
key            = "prod/terraform.tfstate"
region         = "ap-northeast-2"
dynamodb_table = "CHANGE_ME-seoul-vibe-terraform-locks"
encrypt        = true
