# 목적 - prod 환경에서 GCP GKE root module을 실행할 때 필요한 입력값 예시를 제공하기 위해 추가됨
# 설명 - 운영 GCP project와 리전에 맞게 복사 후 수정할 기본 값을 제공한다.
environment    = "prod"
gcp_project_id = "CHANGE_ME"
gcp_region     = "asia-northeast3"

# Example production shape. Adjust after traffic, HA, and cost requirements are fixed.
gke_node_locations     = ["asia-northeast3-a", "asia-northeast3-b"]
gke_node_count         = 1
gke_node_machine_type  = "e2-standard-2"
gke_node_disk_type     = "pd-balanced"
gke_deletion_protection = true
